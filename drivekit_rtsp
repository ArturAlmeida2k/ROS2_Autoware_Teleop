#include <rclcpp/rclcpp.hpp>
#include <sensor_msgs/msg/compressed_image.hpp>
#include <gst/gst.h>
#include <gst/app/gstappsrc.h>
#include <gst/rtsp-server/rtsp-server.h>
#include <vector>
#include <string>
#include <mutex>

// ─────────────────────────────────────────────
// Representa um stream RTSP para uma câmara
// ─────────────────────────────────────────────
class CameraStream {
public:
    CameraStream(const std::string &topic, const std::string &path)
        : topic_(topic), path_(path), appsrc_(nullptr), is_active_(false) {}

    std::string topic_;   // ex: /camera_0/compressed_image
    std::string path_;    // ex: /camera_0
    GstElement *appsrc_;
    GstRTSPMediaFactory *factory_;
    bool is_active_;
    std::mutex mutex_;

    // Chamado quando um cliente se liga ao stream
    void on_media_configure(GstRTSPMediaFactory *factory, GstRTSPMedia *media) {
        GstElement *element = gst_rtsp_media_get_element(media);

        appsrc_ = gst_bin_get_by_name_recurse_up(GST_BIN(element), "mysrc");
        if (!appsrc_) {
            g_printerr("Erro: appsrc não encontrado para %s\n", path_.c_str());
            gst_object_unref(element);
            return;
        }

        g_object_set(G_OBJECT(appsrc_),
                     "stream-type", GST_APP_STREAM_TYPE_STREAM,
                     "format",      GST_FORMAT_TIME,
                     "is-live",     TRUE,
                     "do-timestamp",TRUE,
                     nullptr);

        g_signal_connect(appsrc_, "need-data", (GCallback)on_need_data, this);

        gst_object_unref(element);

        std::lock_guard<std::mutex> lock(mutex_);
        is_active_ = true;
        g_print("Cliente ligado ao stream %s\n", path_.c_str());
    }

    // Chamado quando o cliente pede dados
    static void on_need_data(GstElement *appsrc, guint unused, CameraStream *self) {
        std::lock_guard<std::mutex> lock(self->mutex_);
        self->is_active_ = true;
    }

    // Callback estático para o sinal media-configure
    static void static_on_media_configure(GstRTSPMediaFactory *factory,
                                           GstRTSPMedia *media,
                                           CameraStream *self) {
        self->on_media_configure(factory, media);
    }

    // Envia um frame H264 para o pipeline RTSP
    void push_frame(const sensor_msgs::msg::CompressedImage::SharedPtr msg) {
        std::lock_guard<std::mutex> lock(mutex_);
        if (!appsrc_ || !is_active_) return;

        // Copiar o bitstream H264 para um buffer GStreamer
        GstBuffer *buffer = gst_buffer_new_allocate(nullptr, msg->data.size(), nullptr);
        GstMapInfo map;
        gst_buffer_map(buffer, &map, GST_MAP_WRITE);
        memcpy(map.data, msg->data.data(), msg->data.size());
        gst_buffer_unmap(buffer, &map);

        // Timestamp do header ROS
        GST_BUFFER_PTS(buffer) =
            (guint64)msg->header.stamp.sec * GST_SECOND +
            (guint64)msg->header.stamp.nanosec;

        GstFlowReturn ret;
        g_signal_emit_by_name(appsrc_, "push-buffer", buffer, &ret);
        gst_buffer_unref(buffer);

        if (ret != GST_FLOW_OK) {
            g_printerr("Erro ao enviar buffer para %s: %d\n", path_.c_str(), ret);
        }
    }
};

// ─────────────────────────────────────────────
// Nó ROS2 principal
// ─────────────────────────────────────────────
class RtspStreamerNode : public rclcpp::Node {
public:
    RtspStreamerNode() : Node("rtsp_streamer") {
        // Inicializar GStreamer
        gst_init(nullptr, nullptr);

        // Criar RTSP server
        server_ = gst_rtsp_server_new();
        g_object_set(server_, "service", "8554", nullptr); // porta RTSP

        GstRTSPMountPoints *mounts = gst_rtsp_server_get_mount_points(server_);

        // Criar um stream por câmara
        std::vector<std::string> topics = {
            "/camera_0/compressed_image",
            "/camera_1/compressed_image",
            "/camera_2/compressed_image",
            "/camera_3/compressed_image"
        };
        std::vector<std::string> paths = {
            "/camera_0",
            "/camera_1",
            "/camera_2",
            "/camera_3"
        };

        for (int i = 0; i < 4; i++) {
            auto stream = std::make_shared<CameraStream>(topics[i], paths[i]);

            // Pipeline — sem encoding, só passthrough H264 → RTP
            std::string pipeline =
                "( appsrc name=mysrc is-live=true do-timestamp=true format=time "
                "  caps=video/x-h264,stream-format=byte-stream,alignment=au ! "
                "  h264parse config-interval=-1 ! "
                "  rtph264pay name=pay0 pt=96 mtu=1400 )";

            stream->factory_ = gst_rtsp_media_factory_new();
            gst_rtsp_media_factory_set_launch(stream->factory_, pipeline.c_str());
            gst_rtsp_media_factory_set_shared(stream->factory_, TRUE); // múltiplos clientes

            g_signal_connect(stream->factory_, "media-configure",
                             (GCallback)CameraStream::static_on_media_configure,
                             stream.get());

            gst_rtsp_mount_points_add_factory(mounts, paths[i].c_str(), stream->factory_);

            RCLCPP_INFO(this->get_logger(), "Stream disponível em rtsp://192.168.94.71:8554%s", paths[i].c_str());

            // Subscrição ROS2
            auto sub = this->create_subscription<sensor_msgs::msg::CompressedImage>(
                topics[i],
                rclcpp::QoS(1).best_effort().keep_last(1),
                [stream](const sensor_msgs::msg::CompressedImage::SharedPtr msg) {
                    stream->push_frame(msg);
                }
            );

            streams_.push_back(stream);
            subscriptions_.push_back(sub);
        }

        g_object_unref(mounts);

        // Arrancar o servidor RTSP
        gst_rtsp_server_attach(server_, nullptr);
        RCLCPP_INFO(this->get_logger(), "RTSP server a correr na porta 8554");
    }

    ~RtspStreamerNode() {
        if (server_) gst_object_unref(server_);
    }

private:
    GstRTSPServer *server_;
    std::vector<std::shared_ptr<CameraStream>> streams_;
    std::vector<rclcpp::Subscription<sensor_msgs::msg::CompressedImage>::SharedPtr> subscriptions_;
};

// ─────────────────────────────────────────────
// Main
// ─────────────────────────────────────────────
int main(int argc, char *argv[]) {
    rclcpp::init(argc, argv);

    // GLib main loop necessário para o RTSP server
    GMainLoop *loop = g_main_loop_new(nullptr, FALSE);

    auto node = std::make_shared<RtspStreamerNode>();

    // Correr ROS2 e GLib loop em threads separadas
    std::thread ros_thread([&node]() {
        rclcpp::spin(node);
    });

    g_main_loop_run(loop); // bloqueia aqui, gere o RTSP server

    ros_thread.join();
    rclcpp::shutdown();
    g_main_loop_unref(loop);
    return 0;
}